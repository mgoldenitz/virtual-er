# A list of the settings the app needs, with no real values. Safe to share and commit.
# Copy it to .env.local (which git never saves) and fill in the real values there.
# On Vercel the same names go in Project Settings > Environment Variables.

# Project URL. Supabase dashboard > Project Settings > Data API (or the Connect button).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (starts with sb_publishable_). Safe in the browser: row-level security
# decides what it can do. Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY: never put NEXT_PUBLIC_ in front of it,
# never paste it into chat or another AI model. Only the start-from-home server route
# uses it. Supabase dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=

# Secret for the daily keep-alive job (app/api/keep-alive). Any long random value; Vercel sends
# it with each scheduled call and the route refuses everything else. SERVER ONLY.
# Vercel: Project Settings > Environment Variables, name CRON_SECRET (Production).
CRON_SECRET=

# Pushover settings for the recall alert to the owner's phone (app/api/recall-alert).
# PUSHOVER_USER_KEY: the "Your User Key" value on the first page of pushover.net after sign-in.
# PUSHOVER_APP_TOKEN: the "API Token/Key" of the application you make on pushover.net
# ("Create an Application/API Token"). Keep both out of chat and out of git. SERVER ONLY.
# Leave either one empty to turn the alert off.
# Vercel: Project Settings > Environment Variables, both names (Production and Preview).
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Test staff account for the end-to-end tests (npm run e2e). LOCAL ONLY: never on Vercel.
# Make the user in Supabase dashboard > Authentication > Users > Add user (auto-confirm on),
# then give it the staff role in the SQL Editor. Use a test account, not your own.
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
